# Copy this file to .env and fill in the values. Never commit .env.

# ---- Database ----
# postgresql://user:password@host/dbname  (sqlite:///local.db works for a local trial)
DATABASE_URL=

# ---- Agent mailbox (Gmail: use an App Password, not the account password) ----
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
# Optional: only if the reading login differs from the sending login
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
# To use a company mail server instead of Gmail, set these (defaults are Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# Safe demo mode: true = log emails instead of sending them.
# Set to false only when you are ready to email real people.
EMAIL_DRY_RUN=true

# ---- AI model (see app/llm_client.py) ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# In-house later, for example:
# LLM_PROVIDER=ollama
# LLM_MODEL=gpt-oss:20b
# LLM_BASE_URL=http://your-server:11434

# ---- Working hours / time zone (follow-ups only go out in these hours) ----
TIMEZONE=Asia/Kolkata
WORK_START_HOUR=9
WORK_END_HOUR=18
SKIP_WEEKENDS=true

# ---- Follow-up + escalation policy ----
# Do NOT set the gaps to 0: reminders would be sent on every job pass.
FOLLOWUP_GAP_FAR_HOURS=72
FOLLOWUP_GAP_MID_HOURS=48
FOLLOWUP_GAP_NEAR_HOURS=24
FOLLOWUP_GAP_OVERDUE_HOURS=24
MAX_UNANSWERED_REMINDERS=3
OVERDUE_ESCALATE_AFTER_HOURS=24

# ---- Scheduler ----
ENABLE_SCHEDULER=true
INBOX_POLL_SECONDS=60
FOLLOWUP_JOB_MINUTES=15

# ---- Safety ----
# If set, every API call needs the header  X-API-Key: <this value>.
# Leaving it empty leaves the API open. Always set it, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Require SPF/DKIM pass before a leader's email is treated as an instruction
REQUIRE_EMAIL_AUTH=true